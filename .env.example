# Public, non-secret configuration. Copy to .env.local and fill in when known.
# Anything here is inlined into the client bundle — never put tokens in this file.
#
# The GitHub token behind the contribution calendar is deliberately absent: it
# is a repository secret (GH_CONTRIBUTIONS_TOKEN) read only on the build runner.
# To build locally with the calendar, export GITHUB_TOKEN in your shell instead.
# Without it the build succeeds and the GitHub panel is left out. See the README.

# Canonical site origin, e.g. https://andreszuniga.dev
NEXT_PUBLIC_SITE_URL=

# Professional contact address (no mailto: prefix)
NEXT_PUBLIC_CONTACT_EMAIL=

# Full profile URLs
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_ORCID_URL=
