# Public, non-secret configuration. Copy to .env.local and fill in when known.
# Anything here is inlined into the client bundle — never put tokens in this file.

# Canonical site origin, e.g. https://andreszuniga.dev
NEXT_PUBLIC_SITE_URL=

# Professional contact address (no mailto: prefix)
NEXT_PUBLIC_CONTACT_EMAIL=

# Full profile URLs
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_ORCID_URL=
